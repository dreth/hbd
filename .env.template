HBD_MASTER_KEY=custom_master_key
HBD_ENABLE_BACKUP=false
HBD_USER_ACCESS_KEY_ID=custom_access_key_id
HBD_USER_SECRET_ACCESS_KEY=custom_secret_access_key
HBD_BUCKET_REGION=custom_bucket_region
HBD_BUCKET_NAME=custome_bucket_name

# Optional GlitchTip (Sentry-compatible) reporting; blank DSNs turn it off.
# SENTRY_DSN: Go API (runtime). NEXT_PUBLIC_SENTRY_DSN: browser + Next.js server (image build arg).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
